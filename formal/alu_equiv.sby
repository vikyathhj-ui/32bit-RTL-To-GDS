BK_P0: read_slang --top alu_equiv -GADDER=3 -GPIPE=0 alu_pkg.sv adder.sv adder_beh.sv adder_bk.sv adder_cla4.sv adder_csla.sv adder_hc.sv adder_ks.sv adder_rca.sv adder_sk.sv cla4_unit.sv pg_black.sv pg_gray.sv shifter.sv clz_tree.sv clz.sv cpop.sv alu_top.sv alu_ref_beh.sv alu_equiv.sv
