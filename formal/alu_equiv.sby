# SymbiYosys: full-ALU equivalence vs behavioural reference, every ADDER x PIPE (BRIEF A3 formal 2).
# Run from formal/: sby -f alu_equiv.sby [task]   (or scripts/run_formal.py)

[tasks]
RCA_P0
RCA_P1
CLA4_P0
CLA4_P1
CSLA_P0
CSLA_P1
BK_P0
BK_P1
KS_P0
KS_P1
SK_P0
SK_P1
HC_P0
HC_P1
BEH_P0
BEH_P1

[options]
mode prove
depth 6

[engines]
smtbmc yices

[script]
RCA_P0: read_slang --top alu_equiv -GADDER=0 -GPIPE=0 alu_pkg.sv adder.sv adder_beh.sv adder_bk.sv adder_cla4.sv adder_csla.sv adder_hc.sv adder_ks.sv adder_rca.sv adder_sk.sv cla4_unit.sv pg_black.sv pg_gray.sv shifter.sv clz_tree.sv clz.sv cpop.sv alu_top.sv alu_ref_beh.sv alu_equiv.sv
RCA_P1: read_slang --top alu_equiv -GADDER=0 -GPIPE=1 alu_pkg.sv adder.sv adder_beh.sv adder_bk.sv adder_cla4.sv adder_csla.sv adder_hc.sv adder_ks.sv adder_rca.sv adder_sk.sv cla4_unit.sv pg_black.sv pg_gray.sv shifter.sv clz_tree.sv clz.sv cpop.sv alu_top.sv alu_ref_beh.sv alu_equiv.sv
CLA4_P0: read_slang --top alu_equiv -GADDER=1 -GPIPE=0 alu_pkg.sv adder.sv adder_beh.sv adder_bk.sv adder_cla4.sv adder_csla.sv adder_hc.sv adder_ks.sv adder_rca.sv adder_sk.sv cla4_unit.sv pg_black.sv pg_gray.sv shifter.sv clz_tree.sv clz.sv cpop.sv alu_top.sv alu_ref_beh.sv alu_equiv.sv
